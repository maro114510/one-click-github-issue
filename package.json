{
  "name": "one-click-github-issue",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run --passWithNoTests",
    "release": "gh workflow run release-please.yml --ref main"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
