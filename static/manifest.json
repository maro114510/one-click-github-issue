{
  "manifest_version": 3,
  "name": "One-Click GitHub Issue",
  "version": "0.0.1",
  "description": "Create a GitHub Issue from the current page in one click.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
