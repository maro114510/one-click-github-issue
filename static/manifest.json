{
  "manifest_version": 3,
  "name": "One-Click GitHub Issue",
  "version": "0.0.0",
  "description": "Create a GitHub Issue from the current page in one click.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {},
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
